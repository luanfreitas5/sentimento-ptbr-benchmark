# =============================================================================
# .env.example — variáveis de ambiente (copie para .env e preencha).
# O .env NUNCA é commitado (ver .gitignore). Prefixo: SENTIBENCH_.
# =============================================================================

# URI do backend de rastreamento do MLflow (padrão: store local ./mlruns).
SENTIBENCH_MLFLOW_TRACKING_URI=./mlruns

# Token do Hugging Face — opcional, só necessário para baixar modelos privados.
# O BERTimbau (neuralmind/bert-base-portuguese-cased) é público.
# SENTIBENCH_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
