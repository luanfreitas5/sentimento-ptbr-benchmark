{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "prepare",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": ["prepare"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "train (tfidf_logreg)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": ["train", "--model", "tfidf_logreg", "--no-track"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "benchmark",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": ["benchmark"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest (arquivo atual)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
